# Frontend environment configuration.
# Copy this file to .env and adjust as needed.
# NEVER commit .env files with real credentials.

# Base URL of the backend API (no trailing slash)
# Local (same-origin): /api — Express serves both frontend and API on the same port
# VPS (Nginx proxy):   /api — Nginx proxies /api/ to the backend
# Standalone:          http://localhost:4100/api — cross-origin dev
VITE_API_URL=/api
