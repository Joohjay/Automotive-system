# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
server/.test-server.log

# Test coverage
coverage/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Prisma / local database artifacts
server/.pgdata/
server/prisma/*.db

# Database backups (contain business data — never commit)
backups/

# Per-app deploy configs contain real hostnames/ports (non-secret) — commit
# only the .example templates
deploy/apps/*.env
!deploy/apps/*.env.example
deploy/rendered/

# Misc
.tmp/
*.pem
*.key
*.bak
