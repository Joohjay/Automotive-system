# Backend PRODUCTION environment template.
# Copy this to .env on the production server and fill in REAL values.
# NEVER commit .env to version control, and never commit real secrets.
#
# The server validates production values at startup and refuses to boot with
# unsafe settings (console email provider, placeholder JWT secret, or a
# non-https CLIENT_ORIGIN).

# Environment MUST be production on the server.
NODE_ENV=production

# Port the API listens on (Nginx proxies /api/ to this port).
PORT=4000

# Frontend origin — the HTTPS origin users visit.
# MUST start with https:// in production (the server enforces this).
CLIENT_ORIGIN=https://app.yourdomain.com

# PostgreSQL connection string for the PRODUCTION database.
# NEVER point this at your dev database.
DATABASE_URL=postgresql://autoparts:STRONG_PASSWORD@127.0.0.1:5432/autoparts_prod

# Authentication — MUST be a unique random value.
# Generate with: openssl rand -hex 64
JWT_SECRET=
# Token lifetime (e.g. 8h, 1d). Keep short for security.
JWT_EXPIRES_IN=8h

# Email provider — production REQUIRES "smtp" (console is forbidden).
EMAIL_PROVIDER=smtp

# SMTP configuration (required in production).
# Examples:
#   Gmail:    SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<app-password>
#   Outlook:  SMTP_HOST=smtp.office365.com, SMTP_PORT=587
#   SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASS=<api-key>
#   Mailgun:  SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "from" address on outgoing emails (falls back to SMTP_USER).
SMTP_FROM=no-reply@yourdomain.com