// Automotive Spare Parts Management, POS and Inventory System
// Database schema (Stage 2 — ERD implementation).
//
// Conventions:
// - All IDs are cuid() strings.
// - All money/interest fields are Decimal (PostgreSQL numeric) - never floats.
// - Quantities are signed Int on the inventory ledger.
// - Business records carry createdAt/updatedAt and a creator where relevant.
// - RBAC is data-driven (Role / Permission / RolePermission).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum CreditStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
  TRANSFER
}

enum PurchaseStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  PENDING
  COMPLETED
  VOID
}

enum PaymentMethod {
  CASH
  MPESA
  CREDIT
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ReturnItemCondition {
  NEW
  DAMAGED
}

enum StockTreatment {
  RESTOCK
  DAMAGE
  DISCARD
  DONATE
}

enum ReturnStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum LoanInterestMethod {
  FLAT
  REDUCING_BALANCE
  FIXED_SCHEDULE
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
  CANCELLED
}

enum RepaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum FundingSourceType {
  OWNER_CAPITAL
  LOAN
  OTHER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  LOAN_REMINDER
  LOAN_OVERDUE
  CREDIT_WARNING
  OTHER
}

enum NotificationStatus {
  UNREAD
  READ
}

// ---------------------------------------------------------------------------
// Organisation & users
// ---------------------------------------------------------------------------

model Branch {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  address   String?
  phone     String?
  email     String?
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                 User[]
  storageLocations      StorageLocation[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  purchases             Purchase[]
  sales                 Sale[]
  returns               Return[]
  expenses              Expense[]
  shifts                Shift[]
  loans                 Loan[]
  fundingSources        FundingSource[]
  creditAccounts        CreditAccount[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  settings              Setting[]
  suppliers             Supplier[]
  customers             Customer[]
  expenseCategories     ExpenseCategory[]

  @@index([status])
  @@index([name])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                   String     @id @default(cuid())
  fullName             String
  email                String     @unique
  phone                String?
  passwordHash         String
  status               UserStatus @default(ACTIVE)
  lastLoginAt          DateTime?
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  branchId             String
  roleId               String
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  createdPurchases             Purchase[]
  createdSales                 Sale[]
  createdReturns               Return[]
  createdExpenses              Expense[]
  createdPayments              Payment[]
  createdCreditPayments        CreditPayment[]
  createdLoanPayments          LoanPayment[]
  createdLoans                 Loan[]
  createdFundingSources        FundingSource[]
  createdInventoryTransactions InventoryTransaction[]
  shifts                       Shift[]
  notifications                Notification[]
  auditLogs                    AuditLog[]

  @@index([branchId])
  @@index([roleId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Product catalogue
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([name])
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id            String        @id @default(cuid())
  name          String
  sku           String        @unique
  partNumber    String?       // OEM / manufacturer part number
  description   String?
  compatibility String?       // Vehicle fitment / compatibility notes
  categoryId    String
  brandId       String?
  purchasePrice Decimal       @db.Decimal(12, 2)
  sellingPrice  Decimal       @db.Decimal(12, 2)
  minStockLevel Int           @default(0)
  reorderQty    Int           @default(0)
  unitOfMeasure String        @default("pcs")
  barcode       String? // reserved for future barcode scanning
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])
  brand    Brand?    @relation(fields: [brandId], references: [id])

  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  saleItems             SaleItem[]
  purchaseItems         PurchaseItem[]
  returnItems           ReturnItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model StorageLocation {
  id          String   @id @default(cuid())
  branchId    String
  code        String
  name        String
  type        String   @default("AREA") // RACK | SHELF | BIN | AREA | other
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch       Branch                 @relation(fields: [branchId], references: [id])
  inventory    Inventory[]
  transactions InventoryTransaction[]

  @@unique([branchId, code])
  @@index([branchId, isActive])
}

model Inventory {
  id             String   @id @default(cuid())
  branchId       String
  productId      String
  locationId     String
  quantityOnHand Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch   Branch          @relation(fields: [branchId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  location StorageLocation @relation(fields: [locationId], references: [id])

  @@unique([branchId, productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@index([quantityOnHand])
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  branchId      String
  productId     String
  locationId    String?
  type          InventoryTransactionType
  quantity      Int // signed: + in, - out
  unitCost      Decimal?                 @db.Decimal(12, 2)
  referenceType String // PURCHASE | SALE | RETURN | ...
  referenceId   String
  note          String?
  createdById   String?
  createdAt     DateTime                 @default(now())

  branch   Branch           @relation(fields: [branchId], references: [id])
  product  Product          @relation(fields: [productId], references: [id])
  location StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, branchId])
  @@index([branchId, type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Suppliers & purchasing
// ---------------------------------------------------------------------------

model Supplier {
  id            String         @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxNumber     String?
  status        SupplierStatus @default(ACTIVE)
  branchId      String? // null = shared across branches
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  purchases Purchase[]

  @@index([name])
  @@index([status])
}

model Purchase {
  id           String         @id @default(cuid())
  branchId     String
  supplierId   String
  reference    String // supplier invoice / internal reference
  purchaseDate DateTime       @default(now())
  status       PurchaseStatus @default(PENDING)
  subtotal     Decimal        @db.Decimal(12, 2)
  discount     Decimal        @default(0) @db.Decimal(12, 2)
  total        Decimal        @db.Decimal(12, 2)
  notes        String?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  branch    Branch         @relation(fields: [branchId], references: [id])
  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseItem[]

  @@index([branchId, status])
  @@index([supplierId])
  @@index([purchaseDate])
  @@index([createdById])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  productId   String
  quantity    Int
  receivedQty Int      @default(0) // supports partial receiving
  unitCost    Decimal  @db.Decimal(12, 2)
  totalCost   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Customers & credit
// ---------------------------------------------------------------------------

model Customer {
  id             String         @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?
  customerType   CustomerType   @default(RETAIL)
  creditEligible Boolean        @default(false)
  creditLimit    Decimal        @default(0) @db.Decimal(12, 2)
  status         SupplierStatus @default(ACTIVE)
  branchId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  creditAccount CreditAccount?
  sales         Sale[]
  returns       Return[]

  @@index([name])
  @@index([phone])
  @@index([status])
}

model CreditAccount {
  id                 String       @id @default(cuid())
  customerId         String       @unique
  branchId           String
  creditLimit        Decimal      @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal      @default(0) @db.Decimal(12, 2) // maintained, authoritative source is CreditPayment
  status             CreditStatus @default(OPEN)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  creditPayments CreditPayment[]

  @@index([branchId, status])
}

model CreditPayment {
  id              String        @id @default(cuid())
  creditAccountId String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod @default(CASH)
  reference       String?
  paidAt          DateTime      @default(now())
  createdById     String?
  note            String?
  createdAt       DateTime      @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([creditAccountId])
  @@index([paidAt])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Sales / POS
// ---------------------------------------------------------------------------

model Sale {
  id            String     @id @default(cuid())
  branchId      String
  receiptNumber String
  customerId    String?
  createdById   String? // cashier
  subtotal      Decimal    @db.Decimal(12, 2)
  discount      Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  status        SaleStatus @default(COMPLETED)
  notes         String?
  saleDate      DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  branch    Branch     @relation(fields: [branchId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     SaleItem[]
  payments  Payment[]
  returns   Return[]

  @@unique([branchId, receiptNumber])
  @@index([customerId])
  @@index([createdById])
  @@index([saleDate])
  @@index([branchId, status])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2) // historical, frozen at sale time
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  saleId      String
  method      PaymentMethod @default(CASH)
  amount      Decimal       @db.Decimal(12, 2)
  reference   String? // M-Pesa transaction id, etc.
  status      PaymentStatus @default(COMPLETED)
  paidAt      DateTime      @default(now())
  createdById String?
  createdAt   DateTime      @default(now())

  sale      Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([method])
  @@index([paidAt])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Returns
// ---------------------------------------------------------------------------

model Return {
  id           String       @id @default(cuid())
  branchId     String
  returnNumber String
  saleId       String?
  customerId   String?
  createdById  String?
  reason       String?
  totalRefund  Decimal      @default(0) @db.Decimal(12, 2)
  status       ReturnStatus @default(COMPLETED)
  returnDate   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  branch    Branch       @relation(fields: [branchId], references: [id])
  sale      Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customer  Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     ReturnItem[]

  @@unique([branchId, returnNumber])
  @@index([saleId])
  @@index([customerId])
  @@index([returnDate])
}

model ReturnItem {
  id             String              @id @default(cuid())
  returnId       String
  productId      String
  quantity       Int
  unitPrice      Decimal             @db.Decimal(12, 2)
  reason         String?
  condition      ReturnItemCondition @default(NEW)
  stockTreatment StockTreatment      @default(RESTOCK)
  createdAt      DateTime            @default(now())

  return_ Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  branchId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  expenses Expense[]

  @@index([name])
}

model Expense {
  id            String        @id @default(cuid())
  branchId      String
  categoryId    String
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  expenseDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  createdById   String?
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branch    Branch          @relation(fields: [branchId], references: [id])
  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, expenseDate])
  @@index([categoryId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Funding & loans
// ---------------------------------------------------------------------------

model FundingSource {
  id          String            @id @default(cuid())
  type        FundingSourceType
  description String
  amount      Decimal           @db.Decimal(12, 2)
  sourceDate  DateTime          @default(now())
  branchId    String
  loanId      String?
  createdById String?
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  loan      Loan?  @relation(fields: [loanId], references: [id], onDelete: SetNull)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, sourceDate])
  @@index([type])
}

model Loan {
  id                    String             @id @default(cuid())
  lender                String
  reference             String?
  branchId              String
  principalAmount       Decimal            @db.Decimal(12, 2)
  interestRate          Decimal            @default(0) @db.Decimal(8, 2) // percentage
  interestMethod        LoanInterestMethod @default(FLAT)
  durationMonths        Int                @default(0)
  startDate             DateTime           @default(now())
  maturityDate          DateTime?
  totalExpectedInterest Decimal            @default(0) @db.Decimal(12, 2)
  totalRepayment        Decimal            @default(0) @db.Decimal(12, 2)
  status                LoanStatus         @default(ACTIVE)
  createdById           String?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  branch        Branch          @relation(fields: [branchId], references: [id])
  createdBy     User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  schedules     LoanSchedule[]
  payments      LoanPayment[]
  fundingSource FundingSource[]

  @@index([branchId, status])
  @@index([lender])
  @@index([maturityDate])
}

model LoanSchedule {
  id              String          @id @default(cuid())
  loanId          String
  installmentNo   Int
  dueDate         DateTime
  principalAmount Decimal         @db.Decimal(12, 2)
  interestAmount  Decimal         @default(0) @db.Decimal(12, 2)
  totalDue        Decimal         @db.Decimal(12, 2)
  amountPaid      Decimal         @default(0) @db.Decimal(12, 2)
  status          RepaymentStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  loan     Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@unique([loanId, installmentNo])
  @@index([dueDate])
  @@index([status])
}

model LoanPayment {
  id          String        @id @default(cuid())
  loanId      String
  scheduleId  String?
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod @default(CASH)
  reference   String?
  createdById String?
  note        String?
  createdAt   DateTime      @default(now())

  loan      Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  schedule  LoanSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([scheduleId])
  @@index([paymentDate])
}

// ---------------------------------------------------------------------------
// Notifications & audit
// ---------------------------------------------------------------------------

model Notification {
  id            String             @id @default(cuid())
  userId        String
  branchId      String?
  type          NotificationType
  title         String
  message       String?
  referenceType String?
  referenceId   String?
  status        NotificationStatus @default(UNREAD)
  readAt        DateTime?
  createdAt     DateTime           @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([branchId, type])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  branchId      String?
  action        String // e.g. CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entityType    String // e.g. Product, Sale, Payment
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([branchId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Shifts & settings
// ---------------------------------------------------------------------------

model Shift {
  id                  String      @id @default(cuid())
  branchId            String
  createdById         String? // cashier
  openingCash         Decimal     @default(0) @db.Decimal(12, 2)
  expectedClosingCash Decimal?    @db.Decimal(12, 2)
  actualClosingCash   Decimal?    @db.Decimal(12, 2)
  difference          Decimal?    @db.Decimal(12, 2)
  openedAt            DateTime    @default(now())
  closedAt            DateTime?
  status              ShiftStatus @default(OPEN)
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([createdById])
  @@index([openedAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String
  value       Json
  branchId    String? // null = global setting
  description String?
  updatedAt   DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([branchId, key])
}
