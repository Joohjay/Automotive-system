# Backend environment configuration.
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#   Local: postgresql://autoparts:autoparts@localhost:5432/autoparts
DATABASE_URL=postgresql://autoparts:autoparts@localhost:5432/autoparts

# Authentication
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Token lifetime (e.g. 8h, 1d). 0 means no expiry.
JWT_EXPIRES_IN=8h
