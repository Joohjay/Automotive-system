# Backend environment configuration.
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4100

# Frontend origin allowed by CORS (same-origin when Express serves the frontend)
# Examples:
#   Local (same-origin): http://localhost:4100
#   VPS (Nginx proxy):   https://app.yourdomain.com
CLIENT_ORIGIN=http://localhost:4100

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Examples:
#   Local dev:   postgresql://autoparts:autoparts@localhost:5432/autoparts
#   Production:  postgresql://user:strongpassword@db-host:5432/autoparts_prod
DATABASE_URL=postgresql://autoparts:autoparts@localhost:5432/autoparts?statement_timeout=30000

# Authentication
# Generate with: openssl rand -hex 64
# MUST be at least 32 characters. Use a UNIQUE random value in production.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Token lifetime (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# Email provider: console (logs to stdout) or smtp (sends real emails)
EMAIL_PROVIDER=console

# SMTP configuration (required when EMAIL_PROVIDER=smtp)
# Examples:
#   Gmail:       SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<app-password>
#   Outlook:     SMTP_HOST=smtp.office365.com, SMTP_PORT=587
#   SendGrid:    SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASS=<sendgrid-api-key>
#   Mailgun:     SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "from" address on outgoing emails. Falls back to SMTP_USER if not set.
SMTP_FROM=
