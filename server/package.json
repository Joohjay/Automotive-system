{
  "name": "autoparts-server",
  "version": "0.1.0",
  "private": true,
  "description": "Automotive Spare Parts Management, POS and Inventory System - backend API",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:clean": "tsx scripts/dev-cleanup.ts",
    "db:cashier": "tsx scripts/dev-cashier.ts",
    "db:dev": "node scripts/dev-db.mjs up",
    "db:dev:stop": "node scripts/dev-db.mjs down"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.0",
    "bcryptjs": "^3.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.14.1",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
