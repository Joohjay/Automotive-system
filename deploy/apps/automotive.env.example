# Per-application INFRASTRUCTURE configuration (NON-SECRET values only).
#
# Copy this file to deploy/apps/automotive.env (or run
# `deploy/setup-app.sh automotive`) and edit the values.
#
# NEVER put passwords, JWT secrets or API keys in this file. Those live in the
# application's runtime environment file: <APP_PATH>/server/.env.production
# (generated by deploy/setup-app.sh — also never committed).
#
# Each independent application on the VPS gets its OWN file in deploy/apps/,
# e.g. motorcycle.env, future-app.env. deploy/ecosystem.config.cjs registers
# one PM2 process per file, and deploy/setup-app.sh renders one Nginx virtual
# host per file.

# Identifier used for directories, databases, logs, backups and Nginx filenames.
APP_ID=automotive

# PM2 process name (must be unique across applications on the VPS).
APP_NAME=bennyblax-automotive-api

# Public HTTPS hostname for this application.
APP_HOSTNAME=auto.yourdomain.com

# Absolute path where this application's source/build files live.
APP_PATH=/opt/bennyblax/apps/automotive

# Internal API port (listens on 127.0.0.1 only; NOT exposed publicly).
# Give each application its own port: automotive 4100, motorcycle 4101, ...
API_PORT=4100

# Dedicated PostgreSQL database and user (created by deploy/setup-app.sh).
DB_NAME=bennyblax_automotive
DB_USER=bennyblax_automotive